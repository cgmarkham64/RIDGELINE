{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(find * -name *)",
      "Bash(grep -r * *)",
      "Bash(grep * *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/cgmarkham64/code/ridgeline/.claude/hooks/typecheck-on-write.sh",
            "timeout": 60,
            "statusMessage": "Type-checking..."
          },
          {
            "type": "command",
            "command": "bash /Users/cgmarkham64/code/ridgeline/.claude/hooks/lint-on-write.sh",
            "timeout": 30,
            "statusMessage": "Linting..."
          }
        ]
      }
    ]
  }
}
